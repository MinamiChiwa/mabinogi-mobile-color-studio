/*.spec
/work/*
!/work/studio/
/work/studio/*
__pycache__/
*.pyc
.env
.venv/

# Local-only working/validation notes
VALIDATION.md

# Source and experiment reports are reviewable; captures and runtime data stay local.
!/work/studio/*.py
!/work/studio/*.md
!/work/studio/screenshot_text_fixture.png
/work/studio/data/
/work/studio/release-test-data/

# Local continuation notes
/CONTINUATION_GUIDE.md

# Native production package and its small recognition assets.
!/work/studio/native_live/
/work/studio/native_live/*
!/work/studio/native_live/*.py
!/work/studio/native_live/assets/
/work/studio/native_live/assets/*
!/work/studio/native_live/assets/dye_hex_glyphs.json
!/work/studio/native_live/assets/dye_hex_glyphs.npz
!/work/studio/native_live/assets/dye_timer_hourglass.json
!/work/studio/native_live/assets/dye_timer_hourglass.png
!/work/studio/native-window-check.ps1

# Signed updater sources only; generated assets and private keys remain local.
!/work/studio/updater/
/work/studio/updater/*
!/work/studio/updater/*.py

# Compact models derived from the game font; no original font files.
!/work/studio/native_live/assets/game_font_glyphs.json
!/work/studio/native_live/assets/game_font_glyphs.npz

# Generated packages, runtime records and local configuration at any depth.
outputs/
build/
dist/
venv/
sessions/
*.zip
*.7z
*.exe
*.msi
